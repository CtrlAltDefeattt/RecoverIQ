# Razorpay Test Mode only. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Use a pooled Neon URL in Vercel. Leave empty for local SQLite.
DATABASE_URL=
RECOVERIQ_DATABASE_PATH=data/recoveriq.sqlite3

# Fail-closed execution defaults.
RECOVERIQ_MODE=shadow
RECOVERIQ_EXECUTE_RAZORPAY_ACTIONS=false
RECOVERIQ_AUTONOMOUS_LIMIT_PAISE=1000000
